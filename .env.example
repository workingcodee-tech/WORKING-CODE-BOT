# ============================================================================
# WORKING CODE — TELEGRAM BOT KONFIGURATSIYASI (RAILWAY / PRODUCTION)
# ============================================================================

# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN="1234567890:AAH_your_telegram_bot_token_here"

# Asosiy Administratorning Telegram ID raqami (@userinfobot orqali aniqlanadi)
ADMIN_ID="123456789"

# PostgreSQL ulanish manzili (Railway avtomatik beradigan DATABASE_URL ham qo'llab-quvvatlanadi)
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/working_code_db"

# Vaqt mintaqasi va Log darajasi
TIMEZONE="Asia/Tashkent"
LOG_LEVEL="INFO"

# Vaqtinchalik ogohlantirish xabarlarini avtomatik o'chirish muddati (soniyada)
TEMP_MSG_DELETE_SECONDS="45"

# Brute-force himoyasi: ketma-ket noto'g'ri kod kiritish limiti va bloklash vaqti (soniyada)
RATE_LIMIT_MAX_ATTEMPTS="5"
RATE_LIMIT_LOCK_SECONDS="300"

# ============================================================================
# AI STUDIO PREVIEW SOZLAMALARI
# ============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

